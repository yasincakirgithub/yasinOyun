# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
# Sunucunun alan adini veya public IP'sini ekleyin.
ALLOWED_HOSTS=localhost,127.0.0.1
# HTTPS kullanmiyorsaniz http:// ile baslayan origin'leri ekleyin.
CSRF_TRUSTED_ORIGINS=
# TLS/HTTPS arkasina gecince True yapin.
SECURE_SSL_REDIRECT=False

# PostgreSQL - AWS RDS
DB_ENGINE=django.db.backends.postgresql
DB_NAME=oyunlar
DB_USER=postgres
DB_PASSWORD=your-rds-password
DB_HOST=your-db-identifier.xxxxxxxx.eu-north-1.rds.amazonaws.com
DB_PORT=5432
DATABASE_URL=postgres://postgres:your-rds-password@your-db-identifier.xxxxxxxx.eu-north-1.rds.amazonaws.com:5432/oyunlar?sslmode=require

# Redis (host'ta calisan ortak konteyner)
REDIS_URL=redis://host.docker.internal:6379

# Satranc sesli AI (chess-api.com Stockfish analizi + ElevenLabs TTS)
# Ucretsiz uzak Stockfish servisi; lokal kurulum gerekmez.
SATRANC_STOCKFISH_API_URL=https://chess-api.com/v1
# Kisa analiz icin dusuk depth ve dusunme suresi.
SATRANC_STOCKFISH_DEPTH=12
SATRANC_STOCKFISH_THINKING_TIME=50
SATRANC_AI_COMMENTARY_ENABLED=true
SATRANC_AI_COOLDOWN=7
SATRANC_AI_EVENT_COOLDOWN=20

# ElevenLabs TTS
ELEVENLABS_API_KEY=sk_adb20dd769ea92bd1cfc5907493de14a855eb1a35bd8f2eb
# Turkce konusan herhangi bir ses; kendi ses id'nizi de verebilirsiniz.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Hizli + Turkce destekli: eleven_flash_v2_5 (en hizli) veya eleven_turbo_v2_5.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# 16-bit PCM mono cikti; son sayi ornekleme hizidir.
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
# Konusma hizi (0.7 - 1.2). Dusuk = daha yavas.
ELEVENLABS_SPEED=0.9
