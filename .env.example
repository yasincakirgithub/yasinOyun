# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
# Sunucunun alan adini veya public IP'sini ekleyin.
ALLOWED_HOSTS=localhost,127.0.0.1
# HTTPS kullanmiyorsaniz http:// ile baslayan origin'leri ekleyin.
CSRF_TRUSTED_ORIGINS=
# TLS/HTTPS arkasina gecince True yapin.
SECURE_SSL_REDIRECT=False

# PostgreSQL - AWS RDS
DB_ENGINE=django.db.backends.postgresql
DB_NAME=oyunlar
DB_USER=postgres
DB_PASSWORD=your-rds-password
DB_HOST=your-db-identifier.xxxxxxxx.eu-north-1.rds.amazonaws.com
DB_PORT=5432
DATABASE_URL=postgres://postgres:your-rds-password@your-db-identifier.xxxxxxxx.eu-north-1.rds.amazonaws.com:5432/oyunlar?sslmode=require

# Redis (host'ta calisan ortak konteyner)
REDIS_URL=redis://host.docker.internal:6379
