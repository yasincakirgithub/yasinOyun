# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
# Sunucunun alan adini veya public IP'sini ekleyin.
ALLOWED_HOSTS=localhost,127.0.0.1
# HTTPS kullanmiyorsaniz http:// ile baslayan origin'leri ekleyin.
CSRF_TRUSTED_ORIGINS=
# TLS/HTTPS arkasina gecince True yapin.
SECURE_SSL_REDIRECT=False

# PostgreSQL - AWS RDS
DB_ENGINE=django.db.backends.postgresql
DB_NAME=oyunlar
DB_USER=postgres
DB_PASSWORD=your-rds-password
DB_HOST=your-db-identifier.xxxxxxxx.eu-north-1.rds.amazonaws.com
DB_PORT=5432
DATABASE_URL=postgres://postgres:your-rds-password@your-db-identifier.xxxxxxxx.eu-north-1.rds.amazonaws.com:5432/oyunlar?sslmode=require

# Redis (host'ta calisan ortak konteyner)
REDIS_URL=redis://host.docker.internal:6379

# Satranc motoru
# Yerel Stockfish varsa otomatik kullanilir (hizli, ag gerekmez). Yoksa uzak
# ucretsiz API'ye (chess-api.com) dusulur.
SATRANC_LOCAL_ENGINE=true
# Bos birakilirsa PATH ve bilinen konumlar denenir (Docker'da /usr/bin/stockfish).
SATRANC_STOCKFISH_PATH=
SATRANC_STOCKFISH_API_URL=https://chess-api.com/v1
# Kisa analiz icin dusuk depth ve dusunme suresi.
SATRANC_STOCKFISH_DEPTH=12
SATRANC_STOCKFISH_THINKING_TIME=50

# Bota karsi oyun ve hamle incelemesi
# Seviye 1-8 (bkz. satranc/bot.py); botlar uzak Stockfish depth'i ile guc kazanir.
SATRANC_REVIEW_ENABLED=true
SATRANC_REVIEW_DEPTH=10
SATRANC_REVIEW_THINKING_TIME=50
SATRANC_REVIEW_WORKERS=2
