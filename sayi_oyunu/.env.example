# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
# Sunucunun alan adini veya public IP'sini ekleyin.
ALLOWED_HOSTS=localhost,127.0.0.1
# HTTPS kullanmiyorsaniz http:// ile baslayan origin'leri ekleyin.
CSRF_TRUSTED_ORIGINS=
# TLS/HTTPS arkasina gecince True yapin.
SECURE_SSL_REDIRECT=False

# PostgreSQL (host makinede Docker ile calisan mevcut sunucu)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sayilar
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=host.docker.internal
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/sayilar

# Redis (host'ta calisan ortak konteyner)
REDIS_URL=redis://host.docker.internal:6379

# Optional: Admin credentials
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-password-here
